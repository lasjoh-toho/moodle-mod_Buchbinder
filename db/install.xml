<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/buchbinder/db" VERSION="20260925" COMMENT="XMLDB file for Moodle mod/buchbinder"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="buchbinder" COMMENT="One Buchbinder document per activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="pagerange" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Published excerpt, e.g. 5-12. Empty means all pages."/>
        <FIELD NAME="enablereflow" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="enableprint" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="firstpageright" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Booklet: page 1 is a right page"/>
        <FIELD NAME="ismaster" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Offered in the asset bank as master document"/>
        <FIELD NAME="masterid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="buchbinder.id this document was derived from"/>
        <FIELD NAME="masterrange" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Page range taken from the master"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
        <INDEX NAME="masterid" UNIQUE="false" FIELDS="masterid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="buchbinder_source" COMMENT="Provenance of imported content (files, web snippets, blank templates)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="buchbinderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourcetype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="pdf, docx, html, image, cbz, web, clipboard, blank"/>
        <FIELD NAME="title" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="url" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="author" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeaccessed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="showcitation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="buchbinderid" TYPE="foreign" FIELDS="buchbinderid" REFTABLE="buchbinder" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="buchbinder_page" COMMENT="Pages of a Buchbinder document">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="buchbinderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourceid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="pagetype" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="image" SEQUENCE="false" COMMENT="image or html"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="HTML content for html pages"/>
        <FIELD NAME="contentformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="width" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="height" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="landscapelock" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Protected wide content, never split"/>
        <FIELD NAME="spreadid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Pages that belong to one scanned double page share this id"/>
        <FIELD NAME="spreadside" TYPE="char" LENGTH="5" NOTNULL="false" SEQUENCE="false" COMMENT="left or right"/>
        <FIELD NAME="pinside" TYPE="char" LENGTH="5" NOTNULL="false" SEQUENCE="false" COMMENT="Intended side (left/right), kept by blank filler pages"/>
        <FIELD NAME="filler" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Blank page inserted automatically to keep sides"/>
        <FIELD NAME="pagestyle" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Layout template of the page (e.g. tufte)"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="buchbinderid" TYPE="foreign" FIELDS="buchbinderid" REFTABLE="buchbinder" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="buchbinderid-sortorder" UNIQUE="false" FIELDS="buchbinderid, sortorder"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="buchbinder_overlay" COMMENT="Interactive layers on a page (audio, glossary, mask, textbox, reflow, column)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="overlaytype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="x" TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Relative 0..1"/>
        <FIELD NAME="y" TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="w" TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="h" TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON encoded type specific settings"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pageid" TYPE="foreign" FIELDS="pageid" REFTABLE="buchbinder_page" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="buchbinder_job" COMMENT="Queued background imports">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="buchbinderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="queued" SEQUENCE="false" COMMENT="queued, running, done, failed"/>
        <FIELD NAME="options" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: cleanup steps and source metadata"/>
        <FIELD NAME="filenames" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="pagecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="buchbinderid" TYPE="foreign" FIELDS="buchbinderid" REFTABLE="buchbinder" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
