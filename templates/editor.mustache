{{!
    @template mod_buchbinder/editor

    In-place canvas editor for overlays (type-over, masks, audio, glossary, reflow, columns).

    Example context (json):
    {"nav": [{"number": 1, "current": true, "url": "#", "thumb": "#"}], "isimage": true, "imageurl": "#",
     "html": "", "ratio": 141.4, "config": "{}", "hasglossaries": false}
}}
<div class="mod-buchbinder-editor" id="buchbinder-editor" data-config="{{config}}">
    <nav class="bb-editor-nav" aria-label="{{#str}}pages, mod_buchbinder{{/str}}">
        {{#nav}}
            <a href="{{url}}" class="bb-editor-navitem{{#current}} current{{/current}}" {{#current}}aria-current="page"{{/current}}>
                {{#thumb}}<img src="{{thumb}}" alt="" loading="lazy">{{/thumb}}
                <span>{{number}}</span>
            </a>
        {{/nav}}
    </nav>
    <div class="bb-editor-main">
        <div class="bb-editor-toolbar btn-toolbar mb-2" role="toolbar" aria-label="{{#str}}tools, mod_buchbinder{{/str}}">
            <div class="btn-group mr-2 me-2 mb-1" role="group">
                <button type="button" class="btn btn-outline-secondary active" data-tool="select" aria-pressed="true">{{#str}}tool_select, mod_buchbinder{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-tool="textbox" aria-pressed="false">{{#str}}overlay_textbox, mod_buchbinder{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-tool="mask" aria-pressed="false">{{#str}}overlay_mask, mod_buchbinder{{/str}}</button>
            </div>
            <div class="btn-group mr-2 me-2 mb-1" role="group">
                <button type="button" class="btn btn-outline-secondary" data-tool="audio" aria-pressed="false">{{#str}}overlay_audio, mod_buchbinder{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-tool="glossary" aria-pressed="false" {{^hasglossaries}}disabled title="{{#str}}noglossaries, mod_buchbinder{{/str}}"{{/hasglossaries}}>{{#str}}overlay_glossary, mod_buchbinder{{/str}}</button>
            </div>
            <div class="btn-group mr-2 me-2 mb-1" role="group">
                <button type="button" class="btn btn-outline-secondary" data-tool="reflow" aria-pressed="false">{{#str}}overlay_reflow, mod_buchbinder{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-tool="column" aria-pressed="false">{{#str}}overlay_column, mod_buchbinder{{/str}}</button>
                {{#isimage}}
                <button type="button" class="btn btn-outline-secondary" data-tool="clip" aria-pressed="false">{{#str}}tool_clip, mod_buchbinder{{/str}}</button>
                <button type="button" class="btn btn-outline-secondary" data-action="detect-columns">{{#str}}detectcolumns, mod_buchbinder{{/str}}</button>
                {{/isimage}}
            </div>
        </div>
        <p class="small text-muted">{{#str}}editorhelp, mod_buchbinder{{/str}}</p>
        <div class="bb-editor-workspace">
            <div class="bb-sheet bb-editor-stage{{^isimage}} bb-sheet-html{{/isimage}}"{{#isimage}} style="aspect-ratio: 100 / {{ratio}};"{{/isimage}}>
                {{#isimage}}<img class="bb-image" src="{{imageurl}}" alt="" draggable="false">{{/isimage}}
                {{^isimage}}<div class="bb-html">{{{html}}}</div>{{/isimage}}
            </div>
            <aside class="bb-editor-panel card" aria-live="polite">
                <div class="card-body">
                    <p class="text-muted small mb-0">{{#str}}selectoverlay, mod_buchbinder{{/str}}</p>
                </div>
            </aside>
        </div>
    </div>
</div>
