{{!
    @template mod_buchbinder/desk

    Full screen layout desk: pages panel (double pages), tools, pasteboard with the current double page, properties.

    Example context (json):
    {"name": "Textbook", "config": "{}", "hasglossaries": false, "issues": 0, "addpageurl": "#", "prevurl": "", "nexturl": "#",
     "double": true, "hasstages": true,
     "isdesk": true, "zoom": true,
     "links": {"import": "#", "desk": "#", "pages": "#", "sources": "#", "publish": "#", "preview": "#", "print": "#", "layout": "#", "course": "#"},
     "spreads": [{"index": 0, "current": true, "url": "#", "label": "1", "double": false, "single": "right", "chained": false,
                  "pages": [{"id": 1, "position": 1, "side": "right", "thumb": "", "frames": 1, "blank": false, "issue": false,
                             "alignurl": "#", "linked": "", "pinside": "right", "pinlabel": "R", "filler": false, "canlink": true}]}],
     "stages": [{"id": 1, "position": 1, "side": "right", "sidelabel": "right", "isimage": false, "imageurl": "", "html": "", "ratio": 141.4,
                 "guidestyle": "left:10%;top:7%;width:80%;height:85%;", "noteguidestyle": "", "issue": false, "alignurl": "#",
                 "filler": false, "pinlabel": "",
                 "actions": {"blankbefore": "#", "blankafter": "#", "moveup": "#", "movedown": "#", "delete": "#"} }]}
}}
<div class="bb-desk mod-buchbinder-editor" id="buchbinder-editor" data-config="{{config}}">
    {{> mod_buchbinder/desk_menubar }}
    <div class="bb-desk-formatbar" role="toolbar" aria-label="{{#str}}formatbar, mod_buchbinder{{/str}}" data-region="formatbar">
        <button type="button" data-cmd="undo" title="{{#str}}undo, mod_buchbinder{{/str}}" aria-label="{{#str}}undo, mod_buchbinder{{/str}}">&#x21B6;</button>
        <button type="button" data-cmd="redo" title="{{#str}}redo, mod_buchbinder{{/str}}" aria-label="{{#str}}redo, mod_buchbinder{{/str}}">&#x21B7;</button>
        <span class="bb-fb-sep"></span>
        <select data-block title="{{#str}}paragraphstyle, mod_buchbinder{{/str}}" aria-label="{{#str}}paragraphstyle, mod_buchbinder{{/str}}">
            <option value="p">{{#str}}pstyle_p, mod_buchbinder{{/str}}</option>
            <option value="h1">{{#str}}pstyle_h1, mod_buchbinder{{/str}}</option>
            <option value="h2">{{#str}}pstyle_h2, mod_buchbinder{{/str}}</option>
            <option value="h3">{{#str}}pstyle_h3, mod_buchbinder{{/str}}</option>
            <option value="h4">{{#str}}pstyle_h4, mod_buchbinder{{/str}}</option>
            <option value="blockquote">{{#str}}pstyle_blockquote, mod_buchbinder{{/str}}</option>
            <option value="pre">{{#str}}pstyle_pre, mod_buchbinder{{/str}}</option>
        </select>
        <select data-frame="style" title="{{#str}}framestyle, mod_buchbinder{{/str}}" aria-label="{{#str}}framestyle, mod_buchbinder{{/str}}">
            <option value="">{{#str}}framestyle_standard, mod_buchbinder{{/str}}</option>
            <option value="tufte">{{#str}}pagestyle_tufte, mod_buchbinder{{/str}}</option>
            <option value="sidenote">{{#str}}framestyle_sidenote, mod_buchbinder{{/str}}</option>
        </select>
        <span class="bb-fb-sep"></span>
        <button type="button" data-size="-1" title="{{#str}}fontsmaller, mod_buchbinder{{/str}}" aria-label="{{#str}}fontsmaller, mod_buchbinder{{/str}}">&#x2212;</button>
        <input type="number" data-frame="size" min="5" max="33" step="0.5" value="11" title="{{#str}}fontsizept, mod_buchbinder{{/str}}" aria-label="{{#str}}fontsizept, mod_buchbinder{{/str}}">
        <button type="button" data-size="1" title="{{#str}}fontlarger, mod_buchbinder{{/str}}" aria-label="{{#str}}fontlarger, mod_buchbinder{{/str}}">+</button>
        <span class="bb-fb-sep"></span>
        <button type="button" data-cmd="bold" title="{{#str}}bold, mod_buchbinder{{/str}}" aria-label="{{#str}}bold, mod_buchbinder{{/str}}"><b>B</b></button>
        <button type="button" data-cmd="italic" title="{{#str}}italic, mod_buchbinder{{/str}}" aria-label="{{#str}}italic, mod_buchbinder{{/str}}"><i>I</i></button>
        <button type="button" data-cmd="underline" title="{{#str}}underline, mod_buchbinder{{/str}}" aria-label="{{#str}}underline, mod_buchbinder{{/str}}"><u>U</u></button>
        <button type="button" data-cmd="strikeThrough" title="{{#str}}strikethrough, mod_buchbinder{{/str}}" aria-label="{{#str}}strikethrough, mod_buchbinder{{/str}}"><s>S</s></button>
        <label class="bb-fb-color" title="{{#str}}textcolor, mod_buchbinder{{/str}}"><span aria-hidden="true">A</span>
            <input type="color" data-cmd="foreColor" value="#000000" aria-label="{{#str}}textcolor, mod_buchbinder{{/str}}"></label>
        <label class="bb-fb-color bb-fb-highlight" title="{{#str}}highlight, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x270E;</span>
            <input type="color" data-cmd="hiliteColor" value="#ffec99" aria-label="{{#str}}highlight, mod_buchbinder{{/str}}"></label>
        <span class="bb-fb-sep"></span>
        <button type="button" data-cmd="createLink" title="{{#str}}insertlink, mod_buchbinder{{/str}}" aria-label="{{#str}}insertlink, mod_buchbinder{{/str}}">&#x1F517;</button>
        <span class="bb-fb-sep"></span>
        <button type="button" data-cmd="justifyLeft" title="{{#str}}align_left, mod_buchbinder{{/str}}" aria-label="{{#str}}align_left, mod_buchbinder{{/str}}">&#x2261;<span class="bb-fb-hint">L</span></button>
        <button type="button" data-cmd="justifyCenter" title="{{#str}}align_center, mod_buchbinder{{/str}}" aria-label="{{#str}}align_center, mod_buchbinder{{/str}}">&#x2261;<span class="bb-fb-hint">C</span></button>
        <button type="button" data-cmd="justifyRight" title="{{#str}}align_right, mod_buchbinder{{/str}}" aria-label="{{#str}}align_right, mod_buchbinder{{/str}}">&#x2261;<span class="bb-fb-hint">R</span></button>
        <button type="button" data-cmd="justifyFull" title="{{#str}}align_justify, mod_buchbinder{{/str}}" aria-label="{{#str}}align_justify, mod_buchbinder{{/str}}">&#x2261;<span class="bb-fb-hint">J</span></button>
        <span class="bb-fb-sep"></span>
        <button type="button" data-cmd="insertUnorderedList" title="{{#str}}bulletlist, mod_buchbinder{{/str}}" aria-label="{{#str}}bulletlist, mod_buchbinder{{/str}}">&#x2022;&#x2261;</button>
        <button type="button" data-cmd="insertOrderedList" title="{{#str}}numberedlist, mod_buchbinder{{/str}}" aria-label="{{#str}}numberedlist, mod_buchbinder{{/str}}">1&#x2261;</button>
        <button type="button" data-cmd="outdent" title="{{#str}}outdent, mod_buchbinder{{/str}}" aria-label="{{#str}}outdent, mod_buchbinder{{/str}}">&#x21E4;</button>
        <button type="button" data-cmd="indent" title="{{#str}}indent, mod_buchbinder{{/str}}" aria-label="{{#str}}indent, mod_buchbinder{{/str}}">&#x21E5;</button>
        <span class="bb-fb-sep"></span>
        <button type="button" data-cmd="removeFormat" title="{{#str}}clearformat, mod_buchbinder{{/str}}" aria-label="{{#str}}clearformat, mod_buchbinder{{/str}}">T&#x2093;</button>
        <span class="bb-fb-status" data-region="formatstatus">{{#str}}formatbarhint, mod_buchbinder{{/str}}</span>
    </div>
    <div class="bb-desk-main">
        <aside class="bb-desk-pages" aria-label="{{#str}}pages, mod_buchbinder{{/str}}">
            {{#issues}}
                <div class="bb-desk-issues" role="alert">&#x26A0; {{#str}}layoutissues, mod_buchbinder, {{issues}}{{/str}}</div>
            {{/issues}}
            {{#spreads}}
                <a class="bb-desk-spread{{#current}} current{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}
                    aria-haspopup="menu">
                    <span class="bb-desk-spreadpages{{#single}} single-{{single}}{{/single}}{{#chained}} chained{{/chained}}">
                        {{#pages}}
                            <span class="bb-desk-thumb bb-side-{{side}}{{#blank}} blank{{/blank}}{{#issue}} issue{{/issue}}{{#filler}} filler{{/filler}}"
                                data-pageid="{{id}}" data-position="{{position}}" data-linked="{{linked}}" data-pinside="{{pinside}}"
                                data-filler="{{#filler}}1{{/filler}}" data-canlink="{{#canlink}}1{{/canlink}}">
                                {{#thumb}}<img src="{{thumb}}" alt="" loading="lazy">{{/thumb}}
                                {{^thumb}}{{#frames}}<span class="bb-desk-thumblines"></span>{{/frames}}{{/thumb}}
                                {{#pinlabel}}<span class="bb-desk-pin" title="{{#str}}pinnedpage, mod_buchbinder{{/str}}">{{pinlabel}}</span>{{/pinlabel}}
                                {{#filler}}<span class="bb-desk-auto" title="{{#str}}fillerpage, mod_buchbinder{{/str}}">auto</span>{{/filler}}
                            </span>
                        {{/pages}}
                        {{#chained}}<span class="bb-desk-chain" title="{{#str}}linkedpages, mod_buchbinder{{/str}}">&#x1F517;</span>{{/chained}}
                    </span>
                    <span class="bb-desk-spreadlabel">{{label}}</span>
                </a>
            {{/spreads}}
            <a class="btn btn-sm btn-outline-secondary w-100 mt-2" href="{{addpageurl}}">+ {{#str}}addpage, mod_buchbinder{{/str}}</a>
            <p class="bb-desk-hint">{{#str}}pagesmenuhint, mod_buchbinder{{/str}}</p>
        </aside>
        <div class="bb-desk-tools bb-editor-toolbar" role="toolbar" aria-label="{{#str}}tools, mod_buchbinder{{/str}}" aria-orientation="vertical">
            <button type="button" class="active" data-tool="select" aria-pressed="true" title="{{#str}}tool_select, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x2196;</span><span class="bb-tool-label">{{#str}}tool_select, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="textframe" aria-pressed="false" title="{{#str}}overlay_textframe, mod_buchbinder{{/str}}"><span aria-hidden="true">T</span><span class="bb-tool-label">{{#str}}overlay_textframe, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="imageframe" aria-pressed="false" title="{{#str}}overlay_imageframe, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x25A3;</span><span class="bb-tool-label">{{#str}}overlay_imageframe, mod_buchbinder{{/str}}</span></button>
            <hr>
            <button type="button" data-tool="textbox" aria-pressed="false" title="{{#str}}overlay_textbox, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x270E;</span><span class="bb-tool-label">{{#str}}overlay_textbox, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="mask" aria-pressed="false" title="{{#str}}overlay_mask, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x25AD;</span><span class="bb-tool-label">{{#str}}overlay_mask, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="audio" aria-pressed="false" title="{{#str}}overlay_audio, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x266A;</span><span class="bb-tool-label">{{#str}}overlay_audio, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="glossary" aria-pressed="false" {{^hasglossaries}}disabled{{/hasglossaries}} title="{{#str}}overlay_glossary, mod_buchbinder{{/str}}"><span aria-hidden="true">G</span><span class="bb-tool-label">{{#str}}overlay_glossary, mod_buchbinder{{/str}}</span></button>
            <hr>
            <button type="button" data-tool="reflow" aria-pressed="false" title="{{#str}}overlay_reflow, mod_buchbinder{{/str}}"><span aria-hidden="true">&#xB6;</span><span class="bb-tool-label">{{#str}}overlay_reflow, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="column" aria-pressed="false" title="{{#str}}overlay_column, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x2016;</span><span class="bb-tool-label">{{#str}}overlay_column, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-tool="clip" aria-pressed="false" title="{{#str}}tool_clip, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x2702;</span><span class="bb-tool-label">{{#str}}tool_clip, mod_buchbinder{{/str}}</span></button>
            <button type="button" data-action="detect-columns" title="{{#str}}detectcolumns, mod_buchbinder{{/str}}"><span aria-hidden="true">&#x2261;</span><span class="bb-tool-label">{{#str}}detectcolumns, mod_buchbinder{{/str}}</span></button>
        </div>
        <main class="bb-desk-pasteboard">
            {{#prevurl}}<a class="bb-desk-nav bb-desk-prev" href="{{prevurl}}" title="{{#str}}previousspread, mod_buchbinder{{/str}}">&#x2039;</a>{{/prevurl}}
            {{#nexturl}}<a class="bb-desk-nav bb-desk-next" href="{{nexturl}}" title="{{#str}}nextspread, mod_buchbinder{{/str}}">&#x203A;</a>{{/nexturl}}
            {{^hasstages}}
                <div class="bb-desk-empty">
                    <p>{{#str}}nopages, mod_buchbinder{{/str}}</p>
                    <a class="btn btn-primary" href="{{links.import}}">{{#str}}importfiles, mod_buchbinder{{/str}}</a>
                    <a class="btn btn-secondary" href="{{addpageurl}}">+ {{#str}}addpage, mod_buchbinder{{/str}}</a>
                </div>
            {{/hasstages}}
            <div class="bb-desk-spreadview{{#double}} double{{/double}}">
                {{#stages}}
                <div class="bb-desk-pagewrap bb-side-{{side}}">
                    <div class="bb-desk-pagehead">
                        <span>{{#str}}pagex, mod_buchbinder, {{position}}{{/str}} · {{sidelabel}}
                            {{#pinlabel}}<span class="bb-desk-pin" title="{{#str}}pinnedpage, mod_buchbinder{{/str}}">{{pinlabel}}</span>{{/pinlabel}}
                            {{#filler}}<em class="bb-desk-autonote" title="{{#str}}fillerpage, mod_buchbinder{{/str}}">{{#str}}fillershort, mod_buchbinder{{/str}}</em>{{/filler}}</span>
                        <span class="bb-desk-pageactions">
                            <a href="{{actions.blankbefore}}" title="{{#str}}blankbefore, mod_buchbinder{{/str}}">+&#x2190;</a>
                            <a href="{{actions.blankafter}}" title="{{#str}}blankafter, mod_buchbinder{{/str}}">&#x2192;+</a>
                            <a href="{{actions.moveup}}" title="{{#str}}moveup{{/str}}">&#x25B2;</a>
                            <a href="{{actions.movedown}}" title="{{#str}}movedown{{/str}}">&#x25BC;</a>
                            <a href="{{actions.delete}}" title="{{#str}}delete{{/str}}" class="text-danger" data-action="confirm-delete">&#x2715;</a>
                        </span>
                    </div>
                    {{#issue}}
                        <div class="bb-desk-issue" role="alert">&#x26A0; {{#str}}spreadmisaligned, mod_buchbinder{{/str}}
                            <a href="{{alignurl}}">{{#str}}alignspread, mod_buchbinder{{/str}}</a></div>
                    {{/issue}}
                    <div class="bb-sheet bb-editor-stage" data-pageid="{{id}}" style="aspect-ratio: 100 / {{ratio}};">
                        {{#isimage}}<img class="bb-image" src="{{imageurl}}" alt="" draggable="false">{{/isimage}}
                        {{^isimage}}<div class="bb-html">{{{html}}}</div>{{/isimage}}
                        <div class="bb-guides" style="{{guidestyle}}" aria-hidden="true"></div>
                        {{#noteguidestyle}}<div class="bb-guides bb-guides-notes" style="{{noteguidestyle}}" aria-hidden="true"></div>{{/noteguidestyle}}
                    </div>
                </div>
                {{/stages}}
            </div>
        </main>
        <aside class="bb-editor-panel bb-desk-panel dock-right" aria-label="{{#str}}properties, mod_buchbinder{{/str}}" hidden>
            <div class="bb-desk-panelhead">
                <strong>{{#str}}properties, mod_buchbinder{{/str}}</strong>
                <button type="button" data-action="dock-panel" title="{{#str}}movepanel, mod_buchbinder{{/str}}"
                    aria-label="{{#str}}movepanel, mod_buchbinder{{/str}}">&#x21C4;</button>
                <button type="button" data-action="close-panel" title="{{#str}}closebuttontitle{{/str}}"
                    aria-label="{{#str}}closebuttontitle{{/str}}">&#x2715;</button>
            </div>
            <div class="bb-panel-body" aria-live="polite"></div>
        </aside>
    </div>
</div>
