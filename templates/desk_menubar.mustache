{{!
    @template mod_buchbinder/desk_menubar

    Menu bar of the full screen workspaces (import and layout desk).

    Example context (json):
    {"name": "Textbook", "isimport": true, "isdesk": false, "zoom": false,
     "links": {"import": "#", "desk": "#", "pages": "#", "sources": "#", "publish": "#", "preview": "#", "print": "#",
               "layout": "#", "course": "#"} }
}}
<header class="bb-desk-menubar">
    <a class="bb-desk-brand" href="{{links.course}}" title="{{#str}}backtocourse, mod_buchbinder{{/str}}">&#x2190;</a>
    <strong class="bb-desk-title text-truncate">{{name}}</strong>
    <nav class="bb-desk-menu" aria-label="{{#str}}studio, mod_buchbinder{{/str}}">
        <a href="{{links.import}}"{{#isimport}} class="active" aria-current="page"{{/isimport}}>{{#str}}tab_import, mod_buchbinder{{/str}}</a>
        <a href="{{links.desk}}"{{#isdesk}} class="active" aria-current="page"{{/isdesk}}>{{#str}}desk, mod_buchbinder{{/str}}</a>
        <a href="{{links.pages}}">{{#str}}tab_pages, mod_buchbinder{{/str}}</a>
        <a href="{{links.sources}}">{{#str}}tab_sources, mod_buchbinder{{/str}}</a>
        <a href="{{links.layout}}">{{#str}}newlayoutpage, mod_buchbinder{{/str}}</a>
        <a href="{{links.publish}}">{{#str}}tab_publish, mod_buchbinder{{/str}}</a>
        <a href="{{links.print}}">{{#str}}ecoprint, mod_buchbinder{{/str}}</a>
        <a href="{{links.preview}}" class="bb-desk-preview">{{#str}}preview, mod_buchbinder{{/str}}</a>
    </nav>
    {{#zoom}}
    <label class="bb-desk-zoom">
        <span>{{#str}}zoom, mod_buchbinder{{/str}}</span>
        <input type="range" min="40" max="200" value="100" step="10" data-action="zoom">
    </label>
    {{/zoom}}
</header>
