{{!
    @template mod_buchbinder/layout_preview

    Preview of composed pages.

    Example context (json):
    {"pages": [{"html": "<h1>Title</h1>"}]}
}}
<div class="mod-buchbinder-viewer bb-layout-preview">
    <h4>{{#str}}preview, mod_buchbinder{{/str}}</h4>
    <div class="bb-pages">
    {{#pages}}
        <section class="bb-page">
            <div class="bb-zoomwrap">
                <div class="bb-sheet bb-sheet-html"><div class="bb-html">{{{html}}}</div></div>
            </div>
        </section>
    {{/pages}}
    </div>
</div>
