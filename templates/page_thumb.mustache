{{!
    @template mod_buchbinder/page_thumb

    Miniature of a page: the page image or its frames, scaled with the page (container query units).

    Example context (json):
    {"isimage": false, "imageurl": "", "ratio": 141.4, "hasframes": true, "blank": false,
     "frames": [{"istext": true, "box": "left:10%;top:10%;width:80%;height:20%;", "html": "<p>Text</p>", "styleclass": ""}]}
}}
<div class="bb-sheet bb-thumbsheet" style="aspect-ratio: 100 / {{ratio}};">
    {{#isimage}}<img class="bb-image" src="{{imageurl}}" alt="" loading="lazy" draggable="false">{{/isimage}}
    {{#frames}}
        {{#istext}}<div class="bb-overlay bb-frame bb-textframe {{styleclass}}" style="{{box}}" aria-hidden="true">{{{html}}}</div>{{/istext}}
        {{#isimage}}<div class="bb-overlay bb-frame bb-imageframe" style="{{box}}"><img src="{{src}}" alt="" loading="lazy" draggable="false"{{#cover}} class="bb-cover"{{/cover}}></div>{{/isimage}}
    {{/frames}}
</div>
