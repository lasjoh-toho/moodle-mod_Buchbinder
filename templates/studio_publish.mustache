{{!
    @template mod_buchbinder/studio_publish

    Publishing overview and asset bank tracking.

    Example context (json):
    {"viewurl": "#", "printurl": "#", "hasusage": true,
     "usage": [{"name": "Week 2", "course": "French A1", "range": "5-12", "url": "#"}],
     "master": {"name": "Textbook", "range": "5-12", "url": "#"} }
}}
<div class="mb-3">
    <a class="btn btn-primary mr-2 me-2" href="{{viewurl}}">{{#str}}preview{{/str}}</a>
    <a class="btn btn-secondary" href="{{printurl}}">{{#str}}ecoprint, mod_buchbinder{{/str}}</a>
</div>
{{#master}}
<p>{{#str}}derivedfrom, mod_buchbinder{{/str}} <a href="{{url}}">{{name}}</a> ({{range}})</p>
{{/master}}
<h4>{{#str}}assetusage, mod_buchbinder{{/str}}</h4>
{{^hasusage}}<p class="text-muted">{{#str}}assetusage_none, mod_buchbinder{{/str}}</p>{{/hasusage}}
{{#hasusage}}
<table class="table table-sm">
    <thead><tr><th>{{#str}}name{{/str}}</th><th>{{#str}}course{{/str}}</th><th>{{#str}}pagerange, mod_buchbinder{{/str}}</th></tr></thead>
    <tbody>
    {{#usage}}<tr><td><a href="{{url}}">{{name}}</a></td><td>{{course}}</td><td>{{range}}</td></tr>{{/usage}}
    </tbody>
</table>
{{/hasusage}}
