{{!
    @template mod_buchbinder/assetbank

    List of master documents that can be copied into this activity.

    Example context (json):
    {"hasmasters": true, "actionurl": "#", "cmid": 1, "sesskey": "x",
     "masters": [{"id": 2, "name": "Textbook", "course": "German", "pages": 40, "usage": 3, "viewurl": "#"}]}
}}
{{^hasmasters}}
    <div class="alert alert-info">{{#str}}nomasters, mod_buchbinder{{/str}}</div>
{{/hasmasters}}
{{#hasmasters}}
<table class="table">
    <thead>
        <tr>
            <th>{{#str}}name{{/str}}</th>
            <th>{{#str}}course{{/str}}</th>
            <th>{{#str}}pages, mod_buchbinder{{/str}}</th>
            <th>{{#str}}assetusage, mod_buchbinder{{/str}}</th>
            <th>{{#str}}pagerange, mod_buchbinder{{/str}}</th>
        </tr>
    </thead>
    <tbody>
    {{#masters}}
        <tr>
            <td><a href="{{viewurl}}" target="_blank">{{name}}</a></td>
            <td>{{course}}</td>
            <td>{{pages}}</td>
            <td>{{usage}}</td>
            <td>
                <form method="post" action="{{actionurl}}" class="form-inline d-flex">
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="masterid" value="{{id}}">
                    <input type="text" name="range" class="form-control form-control-sm mr-2 me-2" size="8"
                           placeholder="{{#str}}allpages, mod_buchbinder{{/str}}" aria-label="{{#str}}pagerange, mod_buchbinder{{/str}}">
                    <button type="submit" class="btn btn-sm btn-primary">{{#str}}copypages, mod_buchbinder{{/str}}</button>
                </form>
            </td>
        </tr>
    {{/masters}}
    </tbody>
</table>
{{/hasmasters}}
