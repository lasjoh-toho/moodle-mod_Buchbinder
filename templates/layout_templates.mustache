{{!
    @template mod_buchbinder/layout_templates

    Choice of a starter template for a composed page.

    Example context (json):
    {"templates": [{"name": "Worksheet", "description": "Title, tasks and writing lines", "url": "#"}]}
}}
<div class="bb-layout-templates">
{{#templates}}
    <a class="card bb-layout-template text-reset text-decoration-none" href="{{url}}">
        <div class="card-body">
            <h5 class="card-title">{{name}}</h5>
            <p class="card-text small text-muted mb-0">{{description}}</p>
        </div>
    </a>
{{/templates}}
</div>
